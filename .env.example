# Server Configuration
PORT=3002
NODE_ENV=production

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-browser-safe-supabase-anon-key
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-server-only-supabase-service-role-key
WIDGET_CALL_TOKEN_SECRET=generate-a-long-random-server-only-secret
TURNSTILE_SECRET=your-server-only-turnstile-secret
WIDGET_HOSTED_HOSTNAMES=click2call.ai,localhost,127.0.0.1
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
VITE_DEMO_WIDGET_ID=optional-public-demo-widget-id

# Mobile public Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Socket Server URL (for client connections)
VITE_SOCKET_SERVER_URL=https://io.click2call.ai
