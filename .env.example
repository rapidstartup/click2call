# Server Configuration
PORT=3002
NODE_ENV=production

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_SERVICE_KEY=your-supabase-service-role-key
WIDGET_CALL_TOKEN_SECRET=generate-a-long-random-server-only-secret
VITE_DEMO_WIDGET_ID=optional-public-demo-widget-id

# Mobile public Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Socket Server URL (for client connections)
VITE_SOCKET_SERVER_URL=https://io.click2call.ai:3002
