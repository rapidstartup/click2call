{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run build:server && npm run test:unit:run && npm run test:integration:run && npm run test:e2e:run",
    "test:unit": "npm run build:server && npm run test:unit:run",
    "test:unit:run": "node --test tests/unit/*.test.cjs",
    "test:integration": "npm run build:server && npm run test:integration:run",
    "test:integration:run": "node --test tests/integration/*.test.cjs",
    "test:e2e": "npm run build:server && npm run test:e2e:run",
    "test:e2e:run": "node --test tests/e2e/*.test.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@netlify/functions": "^3.0.1",
    "@supabase/supabase-js": "^2.49.1",
    "@vapi-ai/web": "^2.2.2",
    "antd": "^5.24.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2",
    "recharts": "^2.15.1",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "twilio": "^5.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
