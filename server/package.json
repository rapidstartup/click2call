{
  "name": "click2call-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node index.ts",
    "prebuild": "rm -rf dist/",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "mkdir -p dist/templates && cp -r templates/* dist/templates/",
    "start": "NODE_ENV=production node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "deploy": "npm run build && pm2 delete click2call-server || true && source ../.env && pm2 start ecosystem.config.js"
  },
  "dependencies": {
    "@stream-io/node-sdk": "^0.4.22",
    "@types/twilio": "^3.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "twilio": "^5.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^16.18.38",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
